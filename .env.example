# Booking form → Resend. Set these in Vercel (Project → Settings →
# Environment Variables). Never commit real values.

# Required — your Resend API key, from resend.com → API Keys.
# Server-only secret; do NOT prefix with NEXT_PUBLIC.
RESEND_API_KEY=

# Optional — where booking requests are delivered.
# Defaults to hello@nextgenwatersystems.com.au.
# BOOKING_TO=hello@nextgenwatersystems.com.au

# Optional — the "from" address. Must be on a Resend-verified domain
# (verify nextgenwatersystems.com.au in Resend → Domains first).
# BOOKING_FROM=Next Gen Website <bookings@nextgenwatersystems.com.au>
